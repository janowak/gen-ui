{
  "name": "app-mcp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxfmt --check && oxlint --deny-warnings",
    "dev:setup": "node scripts/dev-setup.ts",
    "dev:tunnel": "cloudflared tunnel run --url http://localhost:4000 50c4b037-363b-413c-9f60-99749a244e35",
    "app-mcp": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree packages/cli/dist/cli.js",
    "deploy:site": "pnpm --filter @app-mcp/site run deploy",
    "deploy:registry": "pnpm --filter @app-mcp/registry run deploy",
    "publish:packages": "node scripts/publish-packages.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  }
}

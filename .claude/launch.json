{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "serve",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "packages/cli/dist/cli.js",
        "serve",
        "examples/rating"
      ],
      "port": 4100
    },
    {
      "name": "demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@app-mcp/demo",
        "start"
      ],
      "port": 3001
    },
    {
      "name": "playground",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@app-mcp/playground",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "registry",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@app-mcp/registry",
        "start"
      ],
      "port": 4000
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@app-mcp/site",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "registry-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@app-mcp/registry",
        "exec",
        "wrangler",
        "dev"
      ],
      "port": 8788
    },
    {
      "name": "site-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@app-mcp/site",
        "exec",
        "wrangler",
        "dev",
        "--port",
        "8787"
      ],
      "port": 8787
    }
  ]
}

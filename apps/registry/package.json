{
  "name": "@genui/registry",
  "version": "0.1.0",
  "type": "module",
  "license": "FSL-1.1-Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "pnpm build:web && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env.local --disable-warning=ExperimentalWarning --import tsx src/main.ts",
    "build:web": "INPUT=sign-in.html vite build web && INPUT=consent.html vite build web"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.12",
    "@better-auth/core": "1.7.12",
    "@better-auth/mcp": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/utils": "^0.5.0",
    "@better-fetch/fetch": "1.3.2",
    "@genui/format": "workspace:*",
    "@genui/ui": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "better-auth": "1.7.12",
    "better-call": "1.4.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "dist-web"
  ]
}

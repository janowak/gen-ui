// app-mcp cloud: the registry as a Worker (src/worker.ts) on D1. One deployment, production (README "Deploy").
// Self-hosting runs the same registry from the Docker image, on SQLite.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-mcp-registry",
  // The Cloudflare account that holds the app-mcp.com zone
  "account_id": "9341ca52ab56b808dfd9a4a673fce52c",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Run next to the database (EU), not next to the caller: a request makes several D1 queries.
  "placement": { "mode": "smart" },
  // Views and sign-in pages are bundled as text
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "observability": { "enabled": true },
  // pnpm dev:worker on http://localhost:8788 (the site's worker uses 8787). Without host, wrangler dev
  // rewrites requests to the route's hostname, and sign-in refuses them as coming from another origin.
  "dev": { "port": 8788, "host": "localhost:8788", "upstream_protocol": "http" },
  "workers_dev": false,
  "routes": [{ "pattern": "api.app-mcp.com", "custom_domain": true }],
  // Created with: wrangler d1 create app-mcp --jurisdiction eu (data stays in the EU)
  "r2_buckets": [{ "binding": "ASSET_BUCKET", "bucket_name": "app-mcp-assets" }],
  // Per-workspace request rates (src/quotas.ts RateLimits). Counted per Cloudflare location, so approximate.
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "END_USER_MCP_LIMITER", "namespace_id": "1002", "simple": { "limit": 1200, "period": 60 } },
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "app-mcp", "database_id": "48612e6f-7b92-40e1-9727-09952a776da3", "migrations_dir": "migrations" },
  ],
  // Secrets (wrangler secret put): APP_MCP_AUTH_SECRET, GOOGLE_CLIENT_ID and _SECRET, GITHUB_CLIENT_ID and _SECRET.
  // Local development reads .dev.vars instead (see .dev.vars.example).
  "vars": {
    "APP_MCP_MODE": "hosted",
    "APP_MCP_PUBLIC_URL": "https://api.app-mcp.com",
    "APP_MCP_ASSET_URL": "https://assets.app-mcp.com/assets/",
  },
}

# Settings for compose.yaml. Copy to registry.env (gitignored) and fill in.

# Where Claude and ChatGPT reach the registry: a public https URL (a tunnel works) for connectors.
GENUI_PUBLIC_URL=http://localhost:4000
# openssl rand -hex 32. Keep it: changing it signs everyone out and breaks every connector.
GENUI_AUTH_SECRET=

# Sign-in: any of these.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GENUI_OIDC_ISSUER=
# GENUI_OIDC_CLIENT_ID=
# GENUI_OIDC_CLIENT_SECRET=
# GENUI_OIDC_NAME=
# GENUI_PASSWORD_LOGIN=true

# Who manages the workspace (default: the first person to sign in), and who may sign in at all.
# GENUI_ADMIN_EMAILS=
# GENUI_ALLOWED_EMAILS=

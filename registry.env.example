# Settings for compose.yaml. Copy to registry.env (gitignored) and fill in.

# Where Claude and ChatGPT reach the registry: a public https URL (a tunnel works) for connectors.
APP_MCP_PUBLIC_URL=http://localhost:4000
# openssl rand -hex 32. Keep it: changing it signs everyone out and breaks every connector.
APP_MCP_AUTH_SECRET=

# Sign-in: any of these.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_MCP_OIDC_ISSUER=
# APP_MCP_OIDC_CLIENT_ID=
# APP_MCP_OIDC_CLIENT_SECRET=
# APP_MCP_OIDC_NAME=
# APP_MCP_PASSWORD_LOGIN=true

# Who manages the workspace (default: the first person to sign in), and who may sign in at all.
# APP_MCP_ADMIN_EMAILS=
# APP_MCP_ALLOWED_EMAILS=

# Static JS/CSS. Default public URL is APP_MCP_PUBLIC_URL/assets/.
# Use a cookie-free asset hostname routed to this registry or a CDN in front of it.
# Keep old URLs reachable so earlier conversations continue loading.
# APP_MCP_ASSET_URL=https://assets.example.com/assets/
# Default disk directory is APP_MCP_DB.assets (inside /data in Docker). Back it up with the DB.
# APP_MCP_ASSET_DIR=/data/assets

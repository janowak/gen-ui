{
  "name": "@genui/ui",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./views/*": "./dist/*",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && for v in form chart manager theme recipes workspace guide; do INPUT=$v.html vite build || exit 1; done",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@genui/format": "workspace:*",
    "@genui/kit": "workspace:*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "preact": "^10.29.5",
    "react": "npm:@preact/compat@18.3.2",
    "react-day-picker": "^10.0.2",
    "react-dom": "npm:@preact/compat@18.3.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}

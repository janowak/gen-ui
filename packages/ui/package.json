{
  "name": "@app-mcp/ui",
  "version": "0.4.1",
  "description": "app-mcp built-in views (forms, charts) as single-file MCP Apps HTML",
  "type": "module",
  "license": "MIT",
  "homepage": "https://app-mcp.com",
  "keywords": [
    "mcp",
    "mcp-apps",
    "app-mcp",
    "claude",
    "chatgpt"
  ],
  "exports": {
    "./views/*": "./dist/*",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && for v in form chart manager theme workflows workspace members tokens connector instructions; do INPUT=$v.html vite build || exit 1; done",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@app-mcp/format": "workspace:*",
    "@app-mcp/kit": "workspace:*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "preact": "^10.29.5",
    "react": "npm:@preact/compat@18.3.2",
    "react-day-picker": "^10.0.2",
    "react-dom": "npm:@preact/compat@18.3.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}

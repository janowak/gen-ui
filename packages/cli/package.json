{
  "name": "@app-mcp/cli",
  "version": "0.4.4",
  "description": "app-mcp CLI: start, develop, serve and publish MCP Apps components",
  "type": "module",
  "license": "MIT",
  "homepage": "https://app-mcp.com",
  "keywords": [
    "mcp",
    "mcp-apps",
    "app-mcp",
    "claude",
    "chatgpt"
  ],
  "bin": {
    "app-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "guide.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@app-mcp/format": "workspace:^",
    "@app-mcp/runtime": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}

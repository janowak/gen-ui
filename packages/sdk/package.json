{
  "name": "@app-mcp/sdk",
  "version": "0.4.1",
  "description": "Put app-mcp forms, charts and components on your own MCP server",
  "type": "module",
  "license": "MIT",
  "homepage": "https://app-mcp.com",
  "keywords": [
    "mcp",
    "mcp-apps",
    "app-mcp",
    "claude",
    "chatgpt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "devDependencies": {
    "@app-mcp/registry": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^24",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}

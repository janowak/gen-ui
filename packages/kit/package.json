{
  "name": "@genui/kit",
  "version": "0.1.0",
  "description": "Build genui components for MCP Apps hosts like Claude and ChatGPT",
  "type": "module",
  "license": "MIT",
  "homepage": "https://app-mcp.com",
  "keywords": [
    "mcp",
    "mcp-apps",
    "genui",
    "claude",
    "chatgpt"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "default": "./dist/state.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./dev": {
      "types": "./dist/dev/start.d.ts",
      "default": "./dist/dev/start.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:harness",
    "build:harness": "vite build -c harness.vite.config.ts --logLevel warn",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.harness.json",
    "test": "pnpm build:harness && vitest run"
  },
  "dependencies": {
    "@genui/format": "workspace:^",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "vite-plugin-singlefile": "^2.3.4",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}

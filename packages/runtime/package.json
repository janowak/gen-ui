{
  "name": "@app-mcp/runtime",
  "version": "0.4.2",
  "description": "app-mcp end-user tools on an MCP server: forms, charts, your components and workflows",
  "type": "module",
  "license": "FSL-1.1-Apache-2.0",
  "homepage": "https://app-mcp.com",
  "keywords": [
    "mcp",
    "mcp-apps",
    "app-mcp",
    "claude",
    "chatgpt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@app-mcp/format": "workspace:^",
    "@app-mcp/ui": "workspace:^",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}

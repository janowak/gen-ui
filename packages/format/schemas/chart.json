{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "line",
        "bar",
        "area",
        "pie",
        "donut"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "x": {
      "description": "Dot path to the category / x value in each row (rows and source modes).",
      "type": "string"
    },
    "series": {
      "description": "Values to plot from each row (rows and source modes).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Dot path to the numeric value inside each row."
          },
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "number",
              "currency",
              "percent"
            ]
          },
          "unit": {
            "description": "Currency code for \"currency\" (e.g. \"EUR\"), or a suffix such as \"ms\".",
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "rows"
          ],
          "description": "Rows you already have. Map them with `x` and `series`."
        },
        {
          "type": "object",
          "properties": {
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "series": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "required": [
                  "name",
                  "values"
                ]
              }
            }
          },
          "required": [
            "categories",
            "series"
          ],
          "description": "Chart-native data for small hand-built charts. No mapping needed."
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "toolName": {
                  "type": "string",
                  "description": "Tool on this server that returns the rows."
                },
                "params": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "Arguments passed to the tool. Fill every parameter the tool requires."
                },
                "itemsPath": {
                  "description": "Dot path to the rows array in the tool result. Omit if the result is the array.",
                  "type": "string"
                }
              },
              "required": [
                "toolName"
              ],
              "description": "The chart fetches rows itself. Use for large (~200+ rows) or live data. Map rows with `x` and `series`."
            }
          },
          "required": [
            "source"
          ]
        }
      ]
    },
    "stacked": {
      "type": "boolean"
    },
    "horizontal": {
      "description": "Bar charts only.",
      "type": "boolean"
    },
    "refreshSeconds": {
      "description": "Source mode only: re-fetch interval.",
      "type": "integer",
      "minimum": 5,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "type",
    "data"
  ]
}
